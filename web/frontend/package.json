{
  "name": "orca-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e": "playwright test --project=chromium",
    "e2e:matrix": "playwright test --project=chromium --project=firefox --project=msedge",
    "e2e:webkit": "playwright test --project=webkit",
    "e2e:all": "npm run e2e:matrix && (npm run e2e:webkit || echo 'Safari/WebKit failed but is non-blocking per docs/web/mvp.md; see the report above.')"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
}
