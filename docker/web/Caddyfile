# The public entry point of compose.prod.yml. Caddy obtains and renews the
# certificate for ORCA_WEB_DOMAIN by itself (Let's Encrypt, or its own local CA
# for "localhost"), redirects HTTP to HTTPS, and forwards everything to the API,
# which also serves the browser screen.
{
	email {$ORCA_WEB_ACME_EMAIL}
	# Caddy's admin API stays on loopback inside the container; the health
	# check reads it there.
	admin localhost:2019
}

{$ORCA_WEB_DOMAIN} {
	# Until accounts exist (lot 7), the whole site sits behind one login.
	basic_auth {
		{$ORCA_WEB_USER} {$ORCA_WEB_PASSWORD_HASH}
	}

	# A slice may carry up to ORCA_WEB_MAX_TOTAL_INPUT_BYTES of models; the
	# API enforces the exact limits, this only stops oversized bodies early.
	request_body {
		max_size {$ORCA_WEB_MAX_REQUEST_BODY:600MB}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy api:8000 {
		# Preview layers are streamed; pass each chunk on at once.
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}
