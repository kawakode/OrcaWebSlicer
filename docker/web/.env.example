# Copy to docker/web/.env (deploy.sh init does it) and fill in. Never commit .env.

# Public host name; its DNS A/AAAA record must point at this server.
ORCA_WEB_DOMAIN=slicer.example.com
# Let's Encrypt contact for expiry and incident notices.
ORCA_WEB_ACME_EMAIL=you@example.com

# Site login until accounts exist. The hash is bcrypt, produced by
# `deploy.sh init` or `deploy.sh password`; keep the single quotes.
ORCA_WEB_USER=orca
ORCA_WEB_PASSWORD_HASH=''

# Image to run. deploy.sh update/rollback rewrite ORCA_WEB_TAG; prefer the
# immutable sha-<commit> tags over "main" so a rollback has a target.
ORCA_WEB_IMAGE=ghcr.io/kawakode/orcawebslicer-web
ORCA_WEB_TAG=main

# Bundled printer vendors offered in the app, comma-separated folder names
# from resources/profiles (each one lengthens startup a little).
ORCA_WEB_PROFILE_VENDORS=Anycubic

# Capacity. Size the memory limit for MAX_CONCURRENT_JOBS workers plus about
# 1 GB for the API; see docs/web/deploy.md.
ORCA_WEB_MAX_CONCURRENT_JOBS=2
ORCA_WEB_MEMORY_LIMIT=6g
ORCA_WEB_CPUS=2
